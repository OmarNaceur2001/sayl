# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anonymous key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private Supabase service-role key. Required for server-side admin
# operations that bypass RLS (workspace creation, webhooks, cron jobs).
# Server-only: never expose to the browser, never commit, never log.
# Find it in Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret used to authenticate scheduled cron requests.
CRON_SECRET=
# Public canonical application URL.
NEXT_PUBLIC_APP_URL=
# Optional AI Gateway key used by AI response nodes.
AI_GATEWAY_API_KEY=
# Optional comma-separated channel picker allowlist; defaults to WhatsApp, Instagram, Facebook, Telegram.
NEXT_PUBLIC_ENABLED_CHANNELS=
